{
  "name": "ci-wiring-fixture",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "pretest": "node scripts/prepare.mjs",
    "bdd:gen": "bddgen --tags \"not @draft\"",
    "test:bank": "npm run bdd:gen && playwright test --project=bank --pass-with-no-tests",
    "test:smoke": "bddgen --tags \"@smoke\" && playwright test --project=bank",
    "lint": "eslint .",
    "test:report": "playwright show-report",
    "test:headed": "playwright test --headed",
    "test:watch": "vitest --watch",
    "ci": "npm run test:smoke",
    "release": "node scripts/release.mjs"
  }
}
